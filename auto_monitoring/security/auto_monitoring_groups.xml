<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Module category -->
        <record id="module_category_auto_monitoring" model="ir.module.category">
            <field name="name">Fleet Monitoring</field>
            <field name="description">Fleet and vehicle monitoring system</field>
            <field name="sequence">50</field>
        </record>

        <!-- User group - can view data -->
        <record id="group_auto_monitoring_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_auto_monitoring"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can view vehicles, trips, and fuel data</field>
        </record>

        <!-- Manager group - can manage vehicles and settings -->
        <record id="group_auto_monitoring_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_auto_monitoring"/>
            <field name="implied_ids" eval="[(4, ref('group_auto_monitoring_user'))]"/>
            <field name="comment">Can manage vehicles and view reports</field>
        </record>

        <!-- Admin group - full access including DB config -->
        <record id="group_auto_monitoring_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_auto_monitoring"/>
            <field name="implied_ids" eval="[(4, ref('group_auto_monitoring_manager'))]"/>
            <field name="comment">Full access including database configuration</field>
        </record>
    </data>
</odoo>
