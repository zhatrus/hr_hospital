<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vehicle Tree View -->
        <record id="auto_monitoring_vehicle_view_tree" model="ir.ui.view">
            <field name="name">auto.monitoring.vehicle.tree</field>
            <field name="model">auto.monitoring.vehicle</field>
            <field name="arch" type="xml">
                <tree string="Vehicles" decoration-muted="not active">
                    <field name="reg_number" string="Держ. номер"/>
                    <field name="vehicle_model" string="Автомобіль"/>
                    <field name="alias" string="Псевдонім"/>
                    <field name="imei" string="IMEI"/>
                    <field name="fuel_card_number" string="Паливна картка"/>
                    <field name="fuel_norm" string="Норма л/100км"/>
                    <field name="last_speed" string="Швидкість"/>
                    <field name="status" string="Статус" widget="badge"
                           decoration-success="status == 'moving'"
                           decoration-danger="status == 'offline'"
                           decoration-warning="status == 'stopped'"
                           decoration-info="status == 'parked'"/>
                    <field name="last_update" string="Оновлено"/>
                    <field name="active" column_invisible="1"/>
                </tree>
            </field>
        </record>

        <!-- Vehicle Form View -->
        <record id="auto_monitoring_vehicle_view_form" model="ir.ui.view">
            <field name="name">auto.monitoring.vehicle.form</field>
            <field name="model">auto.monitoring.vehicle</field>
            <field name="arch" type="xml">
                <form string="Vehicle">
                    <header>
                        <button name="action_refresh_position" type="object"
                                string="Оновити позицію" class="btn-primary"
                                icon="fa-refresh"/>
                        <button name="action_view_on_map" type="object"
                                string="На карті" class="btn-secondary"
                                icon="fa-map-marker"/>
                        <field name="status" widget="statusbar"
                               statusbar_visible="moving,stopped,parked,offline"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(auto_monitoring_trip_action)d" type="action"
                                    class="oe_stat_button" icon="fa-road"
                                    context="{'search_default_vehicle_id': active_id}">
                                <field name="trip_ids" widget="statinfo" string="Поїздки"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                                invisible="active"/>
                        <div class="oe_title">
                            <h1>
                                <field name="reg_number" placeholder="Держ. номер"/>
                            </h1>
                            <h3>
                                <field name="vehicle_model" placeholder="Марка/модель"/>
                            </h3>
                        </div>
                        <group>
                            <group string="Основна інформація">
                                <field name="alias" string="Псевдонім"/>
                                <field name="imei" string="IMEI"/>
                                <field name="serial_number" string="Серійний номер"/>
                                <field name="sim_number" string="SIM номер"/>
                                <field name="external_id" string="Зовнішній ID" readonly="1"/>
                            </group>
                            <group string="Паливо">
                                <field name="fuel_card_number" string="Паливна картка"/>
                                <field name="fuel_norm" string="Норма витрати (л/100км)"/>
                            </group>
                        </group>
                        <group string="Остання позиція" col="4">
                            <field name="last_latitude" string="Широта"/>
                            <field name="last_longitude" string="Довгота"/>
                            <field name="last_speed" string="Швидкість (км/год)"/>
                            <field name="last_fuel" string="Паливо (л)"/>
                            <field name="last_odometer" string="Одометр (км)"/>
                            <field name="last_update" string="Час оновлення"/>
                            <field name="last_address" string="Адреса" colspan="2"/>
                        </group>
                        <field name="active" invisible="1"/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vehicle Kanban View -->
        <record id="auto_monitoring_vehicle_view_kanban" model="ir.ui.view">
            <field name="name">auto.monitoring.vehicle.kanban</field>
            <field name="model">auto.monitoring.vehicle</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" default_group_by="status">
                    <field name="id"/>
                    <field name="reg_number"/>
                    <field name="vehicle_model"/>
                    <field name="alias"/>
                    <field name="status"/>
                    <field name="last_speed"/>
                    <field name="last_address"/>
                    <field name="last_update"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top mb-2">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="reg_number"/>
                                            </strong>
                                            <span t-if="record.alias.raw_value" class="text-muted ms-2">
                                                (<field name="alias"/>)
                                            </span>
                                        </div>
                                        <div class="float-end">
                                            <span t-if="record.status.raw_value == 'moving'" 
                                                  class="badge bg-success">
                                                <i class="fa fa-car"/> <field name="last_speed"/> км/год
                                            </span>
                                            <span t-if="record.status.raw_value == 'parked'" 
                                                  class="badge bg-secondary">
                                                <i class="fa fa-pause"/> Стоянка
                                            </span>
                                            <span t-if="record.status.raw_value == 'stopped'" 
                                                  class="badge bg-warning">
                                                <i class="fa fa-stop"/> Зупинка
                                            </span>
                                            <span t-if="record.status.raw_value == 'offline'" 
                                                  class="badge bg-danger">
                                                <i class="fa fa-times"/> Офлайн
                                            </span>
                                        </div>
                                    </div>
                                    <div class="text-muted small">
                                        <field name="vehicle_model"/>
                                    </div>
                                    <div t-if="record.last_address.raw_value" class="text-muted small mt-1">
                                        <i class="fa fa-map-marker"/> <field name="last_address"/>
                                    </div>
                                    <div class="text-muted small mt-1">
                                        <i class="fa fa-clock-o"/> <field name="last_update"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Vehicle Search View -->
        <record id="auto_monitoring_vehicle_view_search" model="ir.ui.view">
            <field name="name">auto.monitoring.vehicle.search</field>
            <field name="model">auto.monitoring.vehicle</field>
            <field name="arch" type="xml">
                <search string="Search Vehicles">
                    <field name="reg_number" string="Держ. номер"/>
                    <field name="vehicle_model" string="Модель"/>
                    <field name="alias" string="Псевдонім"/>
                    <field name="imei" string="IMEI"/>
                    <field name="fuel_card_number" string="Паливна картка"/>
                    <separator/>
                    <filter name="filter_moving" string="В русі"
                            domain="[('status', '=', 'moving')]"/>
                    <filter name="filter_parked" string="На стоянці"
                            domain="[('status', '=', 'parked')]"/>
                    <filter name="filter_offline" string="Офлайн"
                            domain="[('status', '=', 'offline')]"/>
                    <separator/>
                    <filter name="filter_active" string="Активні"
                            domain="[('active', '=', True)]"/>
                    <filter name="filter_archived" string="Архів"
                            domain="[('active', '=', False)]"/>
                    <separator/>
                    <group expand="0" string="Групувати по...">
                        <filter name="group_status" string="Статус"
                                context="{'group_by': 'status'}"/>
                        <filter name="group_model" string="Модель"
                                context="{'group_by': 'vehicle_model'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Vehicle Action -->
        <record id="auto_monitoring_vehicle_action" model="ir.actions.act_window">
            <field name="name">Транспортні засоби</field>
            <field name="res_model">auto.monitoring.vehicle</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="search_view_id" ref="auto_monitoring_vehicle_view_search"/>
            <field name="context">{'search_default_filter_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Додайте транспортний засіб
                </p>
                <p>
                    Транспортні засоби синхронізуються з зовнішньої бази даних.
                    Натисніть "Синхронізувати ТЗ" для оновлення списку.
                </p>
            </field>
        </record>

        <!-- Sync Vehicles Action -->
        <record id="auto_monitoring_vehicle_sync_action" model="ir.actions.server">
            <field name="name">Синхронізувати ТЗ</field>
            <field name="model_id" ref="model_auto_monitoring_vehicle"/>
            <field name="binding_model_id" ref="model_auto_monitoring_vehicle"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
model.sync_from_external_db()
action = {'type': 'ir.actions.client', 'tag': 'reload'}
            </field>
        </record>

        <!-- Refresh Positions Action -->
        <record id="auto_monitoring_vehicle_refresh_action" model="ir.actions.server">
            <field name="name">Оновити позиції</field>
            <field name="model_id" ref="model_auto_monitoring_vehicle"/>
            <field name="binding_model_id" ref="model_auto_monitoring_vehicle"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
model.update_last_positions()
action = {'type': 'ir.actions.client', 'tag': 'reload'}
            </field>
        </record>
    </data>
</odoo>
