<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Trip Tree View -->
        <record id="auto_monitoring_trip_view_tree" model="ir.ui.view">
            <field name="name">auto.monitoring.trip.tree</field>
            <field name="model">auto.monitoring.trip</field>
            <field name="arch" type="xml">
                <tree decoration-muted="not is_editable" 
                      decoration-warning="not trip_purpose_id"
                      create="false" delete="false">
                    <field name="trip_date" string="Дата"/>
                    <field name="vehicle_id" string="ТЗ"/>
                    <field name="route_description" string="Маршрут" optional="show"/>
                    <field name="trip_purpose_id" string="Мета поїздки"/>
                    <field name="user_comment" string="Коментар" optional="hide"/>
                    <field name="total_km" string="Пробіг (км)" sum="Всього"/>
                    <field name="in_city_km" string="По місту (км)" optional="hide"/>
                    <field name="outside_city_km" string="За містом (км)" optional="hide"/>
                    <field name="fuel_liters" string="Паливо (л)" sum="Всього" optional="show"/>
                    <field name="project_name" string="Проєкт" optional="hide"/>
                    <field name="driver_name" string="Водій" optional="hide"/>
                    <field name="is_editable" string="Можна редагувати" widget="boolean" optional="show"/>
                    <field name="status" column_invisible="1"/>
                </tree>
            </field>
        </record>

        <!-- Trip Form View -->
        <record id="auto_monitoring_trip_view_form" model="ir.ui.view">
            <field name="name">auto.monitoring.trip.form</field>
            <field name="model">auto.monitoring.trip</field>
            <field name="arch" type="xml">
                <form string="Trip" create="false" delete="false">
                    <sheet>
                        <widget name="web_ribbon" title="Редагування заблоковано" 
                                bg_color="bg-danger" 
                                invisible="is_editable or is_manager"/>
                        <widget name="web_ribbon" title="Заповніть мету поїздки" 
                                bg_color="bg-warning" 
                                invisible="trip_purpose_id or not is_editable"/>
                        <div class="oe_title">
                            <h1>
                                <field name="vehicle_id" readonly="1"/>
                            </h1>
                            <h3>
                                <field name="trip_date" readonly="1"/>
                            </h3>
                        </div>
                        
                        <group>
                            <group string="Основна інформація">
                                <field name="imei" readonly="1"/>
                                <field name="driver_name" string="Водій" readonly="1"/>
                                <field name="project_name" string="Проєкт" readonly="1"/>
                                <field name="payment_type" string="Тип оплати" readonly="1"/>
                            </group>
                            <group string="Час">
                                <field name="start_time" string="Початок" readonly="1"/>
                                <field name="end_time" string="Завершення" readonly="1"/>
                                <field name="updated_at" string="Оновлено" readonly="1"/>
                            </group>
                        </group>
                        
                        <group string="Маршрут">
                            <field name="route_description" string="Опис маршруту" readonly="1" colspan="2"/>
                            <field name="start_address" string="Звідки" readonly="1"/>
                            <field name="end_address" string="Куди" readonly="1"/>
                        </group>
                        
                        <group>
                            <group string="Пробіг">
                                <field name="in_city_km" string="По місту (км)" readonly="1"/>
                                <field name="outside_city_km" string="За містом (км)" readonly="1"/>
                                <field name="total_km" string="Загальний (км)" readonly="1"/>
                            </group>
                            <group string="Коефіцієнти та паливо">
                                <field name="city_coefficient" string="Коеф. по місту" readonly="1"/>
                                <field name="outside_coefficient" string="Коеф. за містом" readonly="1"/>
                                <field name="fuel_liters" string="Паливо (л)" readonly="1"/>
                            </group>
                        </group>
                        
                        <separator string="Редаговані поля"/>
                        <group>
                            <group string="Мета поїздки">
                                <field name="trip_purpose_id" 
                                       string="Оберіть мету"
                                       options="{'no_create': True, 'no_open': True}"
                                       readonly="not is_editable and not is_manager"
                                       required="1"/>
                                <field name="trip_purpose_other" 
                                       string="Інша мета (якщо обрано 'Інше')"
                                       readonly="not is_editable and not is_manager"
                                       invisible="not trip_purpose_id or trip_purpose_id.code != 'other'"/>
                            </group>
                            <group string="Коментар">
                                <field name="user_comment" 
                                       string="Ваш коментар"
                                       placeholder="Додайте коментар до поїздки..."
                                       readonly="not is_editable and not is_manager"
                                       colspan="2" nolabel="1"/>
                            </group>
                        </group>
                        
                        <field name="is_editable" invisible="1"/>
                        <field name="is_manager" invisible="1"/>
                        <field name="external_id" invisible="1"/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Trip Search View -->
        <record id="auto_monitoring_trip_view_search" model="ir.ui.view">
            <field name="name">auto.monitoring.trip.search</field>
            <field name="model">auto.monitoring.trip</field>
            <field name="arch" type="xml">
                <search string="Search Trips">
                    <field name="vehicle_id" string="ТЗ"/>
                    <field name="trip_purpose_id" string="Мета поїздки"/>
                    <field name="route_description" string="Маршрут"/>
                    <field name="driver_name" string="Водій"/>
                    <field name="project_name" string="Проєкт"/>
                    <separator/>
                    <filter name="filter_today" string="Сьогодні"
                            domain="[('trip_date', '=', (context_today()).strftime('%Y-%m-%d'))]"/>
                    <filter name="filter_this_week" string="Цей тиждень"
                            domain="[('trip_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <filter name="filter_this_month" string="Цей місяць"
                            domain="[('trip_date', '>=', (context_today()).strftime('%Y-%m-01'))]"/>
                    <separator/>
                    <filter name="filter_editable" string="Можна редагувати"
                            domain="[('is_editable', '=', True)]"/>
                    <filter name="filter_no_purpose" string="Без мети"
                            domain="[('trip_purpose_id', '=', False)]"/>
                    <filter name="filter_no_comment" string="Без коментаря"
                            domain="[('user_comment', '=', False)]"/>
                    <separator/>
                    <group expand="0" string="Групувати по...">
                        <filter name="group_vehicle" string="ТЗ"
                                context="{'group_by': 'vehicle_id'}"/>
                        <filter name="group_purpose" string="Мета поїздки"
                                context="{'group_by': 'trip_purpose_id'}"/>
                        <filter name="group_date" string="Дата"
                                context="{'group_by': 'trip_date'}"/>
                        <filter name="group_driver" string="Водій"
                                context="{'group_by': 'driver_name'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Trip Pivot View -->
        <record id="auto_monitoring_trip_view_pivot" model="ir.ui.view">
            <field name="name">auto.monitoring.trip.pivot</field>
            <field name="model">auto.monitoring.trip</field>
            <field name="arch" type="xml">
                <pivot string="Trip Analysis">
                    <field name="trip_date" type="col" interval="month"/>
                    <field name="in_city_km" string="По місту (км)" type="measure"/>
                    <field name="outside_city_km" string="За містом (км)" type="measure"/>
                    <field name="total_km" string="Загальний пробіг (км)" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Trip Graph View -->
        <record id="auto_monitoring_trip_view_graph" model="ir.ui.view">
            <field name="name">auto.monitoring.trip.graph</field>
            <field name="model">auto.monitoring.trip</field>
            <field name="arch" type="xml">
                <graph string="Mileage by Vehicle" type="bar">
                    <field name="trip_date" type="row" interval="month"/>
                    <field name="total_km" string="Загальний пробіг (км)" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Trip Action -->
        <record id="auto_monitoring_trip_action" model="ir.actions.act_window">
            <field name="name">Поїздки</field>
            <field name="res_model">auto.monitoring.trip</field>
            <field name="view_mode">tree,pivot,graph,form</field>
            <field name="search_view_id" ref="auto_monitoring_trip_view_search"/>
            <field name="context">{'search_default_filter_this_month': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Поїздки
                </p>
                <p>
                    Поїздки завантажуються з зовнішньої бази даних.
                    Оберіть авто та дату для перегляду.
                </p>
            </field>
        </record>

        <!-- Trip Analytics Action -->
        <record id="auto_monitoring_trip_analytics_action" model="ir.actions.act_window">
            <field name="name">Аналітика пробігу</field>
            <field name="res_model">auto.monitoring.trip</field>
            <field name="view_mode">pivot,graph,tree</field>
            <field name="search_view_id" ref="auto_monitoring_trip_view_search"/>
            <field name="context">{'search_default_filter_this_month': 1}</field>
        </record>
</odoo>
