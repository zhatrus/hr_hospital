<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default configuration parameters for external DB connection -->
        <record id="config_param_db_host" model="ir.config_parameter">
            <field name="key">auto_monitoring.db_host</field>
            <field name="value">localhost</field>
        </record>
        
        <record id="config_param_db_port" model="ir.config_parameter">
            <field name="key">auto_monitoring.db_port</field>
            <field name="value">5432</field>
        </record>
        
        <record id="config_param_db_name" model="ir.config_parameter">
            <field name="key">auto_monitoring.db_name</field>
            <field name="value">monitoring</field>
        </record>
        
        <record id="config_param_db_user" model="ir.config_parameter">
            <field name="key">auto_monitoring.db_user</field>
            <field name="value">lynx</field>
        </record>
        
        <record id="config_param_db_password" model="ir.config_parameter">
            <field name="key">auto_monitoring.db_password</field>
            <field name="value"></field>
        </record>
        
        <!-- Speed limit for violations -->
        <record id="config_param_speed_limit" model="ir.config_parameter">
            <field name="key">auto_monitoring.speed_limit</field>
            <field name="value">130</field>
        </record>
    </data>
</odoo>
